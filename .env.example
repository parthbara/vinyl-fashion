# ─────────────────────────────────────────────────────────────────
#  VINYL FASHION — environment
#  Copy this file to `.env` and fill in real values. `.env` is
#  git-ignored; never commit real keys. Only VITE_* vars reach the
#  browser bundle — anything secret must stay WITHOUT the VITE_ prefix
#  and be used from a server/edge function only.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (data layer: albums, products, orders, customers) ───
# From Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Bypasses row-level security — use ONLY in edge
# functions / admin scripts. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Gemini (AI "Atelier Assistant") ──────────────────────────────
# Google AI Studio → Get API key. The assistant currently runs a
# local fallback; when wired to Gemini, the key must be used from a
# serverless/edge function (NOT VITE_*, or it leaks in the bundle).
GEMINI_API_KEY=your-gemini-api-key-here
# Model id is safe to expose; tune freely.
VITE_GEMINI_MODEL=gemini-2.0-flash

# ── Brand / contact ──────────────────────────────────────────────
# Full international format, no +, spaces, or leading zeros.
VITE_WHATSAPP_NUMBER=your-whatsapp-number-here

# ── Admin ────────────────────────────────────────────────────────
# Hidden admin route (no link anywhere on the storefront).
VITE_ADMIN_PATH=33rpm
